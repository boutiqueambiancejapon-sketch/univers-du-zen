<section class="customer-page page-width">
  <h1>{{ 'customer.reset.title' | t }}</h1>

  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="field">
      <label for="reset-password">{{ 'customer.reset.password' | t }}</label>
      <input type="password" name="customer[password]" id="reset-password" autocomplete="new-password" required>
    </div>
    <div class="field">
      <label for="reset-password-confirm">{{ 'customer.reset.password_confirm' | t }}</label>
      <input type="password" name="customer[password_confirmation]" id="reset-password-confirm" autocomplete="new-password" required>
    </div>
    <button type="submit" class="btn btn--primary" style="width:100%">{{ 'customer.reset.submit' | t }}</button>
  {%- endform -%}
</section>
