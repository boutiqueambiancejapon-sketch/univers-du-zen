<section class="customer-page customer-page--wide page-width">
  <h1>{{ 'customer.account.title' | t }}</h1>
  <p style="margin-bottom:2rem">
    {{ customer.name }} ·
    <a href="{{ routes.account_addresses_url }}" style="text-decoration:underline">{{ 'customer.account.addresses' | t }}</a> ·
    <a href="{{ routes.account_logout_url }}" style="text-decoration:underline">{{ 'customer.account.logout' | t }}</a>
  </p>

  <h2 style="font-size:1.25rem;margin-bottom:1rem">{{ 'customer.account.orders' | t }}</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size > 0 -%}
      <table class="order-table">
        <thead>
          <tr>
            <th>{{ 'customer.account.order_number' | t }}</th>
            <th>{{ 'customer.account.date' | t }}</th>
            <th>{{ 'customer.account.status' | t }}</th>
            <th>{{ 'customer.account.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr>
              <td><a href="{{ order.customer_url }}" style="color:var(--color-terracotta)">{{ order.name }}</a></td>
              <td>{{ order.created_at | date: '%d/%m/%Y' }}</td>
              <td>{{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</td>
              <td>{{ order.total_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- else -%}
      <p style="color:var(--color-muted)">{{ 'customer.account.no_orders' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</section>
