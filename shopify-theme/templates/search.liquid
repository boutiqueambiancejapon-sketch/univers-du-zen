<section class="page-width" style="padding-top:3.5rem">
  <div class="util-page" style="padding-bottom:1rem">
    <h1>{{ 'general.search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" class="search-form" role="search">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.title' | t }}">
      <input type="hidden" name="type" value="product">
      <button type="submit" class="btn btn--dark">{{ 'general.search.submit' | t }}</button>
    </form>
  </div>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p class="collection-empty">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
    {%- else -%}
      <p class="collection-toolbar__count" style="display:block;margin-bottom:1.5rem">
        {{ 'general.search.results_with_count' | t: count: search.results_count, terms: search.terms }}
      </p>
      {%- paginate search.results by 24 -%}
        <div class="collection-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">‹</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}<span class="is-current">{{ part.title }}</span>
              {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">›</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  {%- endif -%}
</section>
