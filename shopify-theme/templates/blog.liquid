<section class="page-width" style="padding:3.5rem 0 4rem">
  <p class="section-eyebrow">Journal</p>
  <h1 class="section-title">{{ blog.title }}</h1>

  {%- paginate blog.articles by 12 -%}
    <div class="collection-grid" style="margin-top:2rem">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="product-card" style="display:block">
          {%- if article.image -%}
            <div class="product-card__media" style="aspect-ratio:4/3">
              {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'is-cover', alt: article.title }}
            </div>
          {%- endif -%}
          <div class="product-card__info">
            <p class="product-card__cat">{{ article.published_at | date: '%d/%m/%Y' }}</p>
            <h3 class="product-card__title" style="font-family:var(--font-serif);font-size:1.05rem">{{ article.title }}</h3>
            <p style="font-size:.875rem;color:var(--color-muted)">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
          </div>
        </a>
      {%- else -%}
        <p class="collection-empty">Aucun article pour le moment.</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">‹</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}<span class="is-current">{{ part.title }}</span>
          {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">›</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>
