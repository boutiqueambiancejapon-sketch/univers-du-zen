{%- assign col = section.settings.collection -%}
<section class="featured page-width">
  <div class="featured__header">
    <div class="featured__header-text">
      <p class="section-eyebrow">— {{ section.settings.eyebrow }}</p>
      <h2 class="section-title">{{ section.settings.heading | default: col.title }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="featured__desc">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>
    <div class="featured__arrows">
      <button type="button" class="featured__arrow" data-scroll-dir="left" aria-label="{{ 'general.pagination.previous' | t }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="featured__arrow" data-scroll-dir="right" aria-label="{{ 'general.pagination.next' | t }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    </div>
  </div>

  <div class="featured__scroll" data-scroller>
    <div class="featured__hero-card" style="background-color: {{ section.settings.card_bg }}">
      <div>
        <p class="featured__hero-card-meta">
          {%- if col != blank -%}{{ col.products_count }} pièces{%- endif -%}
        </p>
        <h3>{{ section.settings.heading | default: col.title }}</h3>
        <p class="featured__hero-card-desc">{{ section.settings.description }}</p>
      </div>
      <a href="{% if col != blank %}{{ col.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="btn btn--primary">
        Voir la collection →
      </a>
    </div>

    {%- for product in col.products limit: section.settings.products_to_show -%}
      {%- liquid
        assign on_sale = false
        if product.compare_at_price > product.price
          assign on_sale = true
          assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
        endif
      -%}
      <div class="mini-card">
        <a href="{{ product.url }}" class="mini-card__img">
          {%- if product.featured_image != blank -%}
            {{ product.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}
          {%- endif -%}
          {%- if on_sale -%}
            <span class="mini-card__badge">Édition limitée</span>
          {%- elsif product.tags contains 'best-seller' or product.tags contains 'bestseller' -%}
            <span class="mini-card__badge">{{ 'products.product.best_seller' | t }}</span>
          {%- endif -%}
        </a>
        {%- if product.available and product.variants.size == 1 -%}
          <form method="post" action="{{ routes.cart_add_url }}" data-ajax-cart class="mini-card__add-form">
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button type="submit" class="mini-card__add" aria-label="{{ 'products.product.add_to_cart' | t }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
            </button>
          </form>
        {%- endif -%}
        <div class="mini-card__info">
          {%- if product.type != blank -%}<p class="mini-card__cat">{{ product.type }}</p>{%- endif -%}
          <a href="{{ product.url }}"><p class="mini-card__title">{{ product.title }}</p></a>
          <div class="mini-card__prices">
            <span class="mini-card__price">{{ product.price | money }}</span>
            {%- if on_sale -%}
              <span class="mini-card__compare">{{ product.compare_at_price | money }}</span>
              <span style="font-size:10px;color:var(--color-terracotta);font-weight:600">-{{ discount }}%</span>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection en vedette",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Nouveautés" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Huiles de Fragrance" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Nos huiles parfumées naturelles pour diffuseur, brûle-parfum et créations DIY." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "color", "id": "card_bg", "label": "Couleur de la carte", "default": "#2B4036" },
    { "type": "range", "id": "products_to_show", "label": "Nombre de produits", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Collection en vedette" }]
}
{% endschema %}
