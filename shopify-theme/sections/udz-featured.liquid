<section class="udz-sec{% if section.settings.tint %} udz-sec--tint{% endif %}">
  <div class="wrap">
    <div class="udz-sechead udz-sechead--center" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="udz-grid">
      {%- assign col = collections[section.settings.collection] -%}
      {%- assign limit = section.settings.count | default: 4 -%}
      {%- for product in col.products limit: limit -%}
        {% render 'udz-card', product: product %}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="udz-card"><div class="udz-card__media"></div><div class="udz-card__body"><div class="udz-card__name">Produit</div></div></div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Produits à la une",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Les préférés de la communauté" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nos best-sellers" },
    { "type": "collection", "id": "collection", "label": "Collection source" },
    { "type": "range", "id": "count", "label": "Nombre de produits", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "tint", "label": "Fond teinté", "default": true }
  ],
  "presets": [{ "name": "Produits à la une" }]
}
{% endschema %}
