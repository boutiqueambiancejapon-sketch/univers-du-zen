<section class="hero">
  <div class="hero__bg">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt | default: shop.name }}
    {%- else -%}
      <img src="{{ 'udz-hero-homepage.jpeg' | asset_url }}" alt="Ambiance zen — bougies et aromathérapie" fetchpriority="high">
    {%- endif -%}
  </div>
  <div class="hero__overlay"></div>

  <div class="page-width hero__inner">
    <div class="hero__content">

      {%- if section.settings.badge_text != blank -%}
        <div class="hero__badge">
          <span class="hero__badge-dot"></span>
          {{ section.settings.badge_text }}
        </div>
      {%- endif -%}

      <h1 class="hero__title">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <br><em>{{ section.settings.heading_accent }}</em> {{ section.settings.heading_end }}
        {%- endif -%}
      </h1>

      {%- if section.settings.lead != blank -%}
        <p class="hero__lead">{{ section.settings.lead }}</p>
      {%- endif -%}

      <div class="hero__ctas">
        {%- if section.settings.cta1_label != blank -%}
          <a href="{{ section.settings.cta1_link | default: routes.all_products_collection_url }}" class="btn btn--primary">{{ section.settings.cta1_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a href="{{ section.settings.cta2_link | default: routes.all_products_collection_url }}" class="btn btn--ghost">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>

      {%- if section.settings.show_proof -%}
        <div class="hero__proof">
          <div class="hero__avatars">
            <span class="hero__avatar" style="background:#4A7C59;z-index:4">SL</span>
            <span class="hero__avatar" style="background:#8B4B2A;z-index:3">MA</span>
            <span class="hero__avatar" style="background:#2B4F6B;z-index:2">CJ</span>
            <span class="hero__avatar" style="background:#6B4A8B;z-index:1">PD</span>
          </div>
          <div>
            <div class="hero__stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              {%- endfor -%}
            </div>
            <p class="hero__proof-text">{{ section.settings.proof_text }}</p>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.trust_title != blank -%}
    <div class="hero__trust-card">
      <div class="hero__trust-card-inner">
        <div class="hero__trust-icon">
          <svg fill="none" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </div>
        <div>
          <p>{{ section.settings.trust_title }}</p>
          <p>{{ section.settings.trust_subtitle }}</p>
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Bannière héro",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image de fond" },
    { "type": "text", "id": "badge_text", "label": "Badge", "default": "Sélection 100% naturelle & éthique" },
    { "type": "text", "id": "heading", "label": "Titre (ligne 1)", "default": "Votre parenthèse" },
    { "type": "text", "id": "heading_accent", "label": "Mot accentué (ligne 2)", "default": "zen" },
    { "type": "text", "id": "heading_end", "label": "Fin du titre (ligne 2)", "default": "au quotidien" },
    { "type": "textarea", "id": "lead", "label": "Texte d'introduction", "default": "Aromathérapie, bougies, cristaux et déco — une sélection éthique livrée depuis l'Europe en 3 à 5 jours." },
    { "type": "text", "id": "cta1_label", "label": "Bouton principal", "default": "Découvrir la boutique" },
    { "type": "url", "id": "cta1_link", "label": "Lien bouton principal" },
    { "type": "text", "id": "cta2_label", "label": "Bouton secondaire", "default": "Nos best-sellers →" },
    { "type": "url", "id": "cta2_link", "label": "Lien bouton secondaire" },
    { "type": "checkbox", "id": "show_proof", "label": "Afficher la preuve sociale", "default": true },
    { "type": "text", "id": "proof_text", "label": "Texte preuve sociale", "default": "4,8/5 · 347+ clients satisfaits" },
    { "type": "text", "id": "trust_title", "label": "Carte confiance — titre", "default": "Livraison offerte" },
    { "type": "text", "id": "trust_subtitle", "label": "Carte confiance — sous-titre", "default": "dès 59 € · expédié sous 48h" }
  ],
  "presets": [{ "name": "Bannière héro" }]
}
{% endschema %}
