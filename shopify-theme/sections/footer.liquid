<footer class="site-footer">
  <div class="page-width site-footer__grid">

    <div>
      <span class="site-footer__brand-name">{{ shop.name }}</span>
      {%- if section.settings.brand_text != blank -%}
        <p class="site-footer__brand-text">{{ section.settings.brand_text }}</p>
      {%- endif -%}
      {%- if section.settings.brand_note != blank -%}
        <p class="site-footer__brand-note">{{ section.settings.brand_note }}</p>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
        <ul class="site-footer__links">
          {%- for link in linklists[block.settings.menu].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>

  <div class="site-footer__bottom">
    <div class="page-width site-footer__bottom-inner">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Tous droits réservés.</span>
      <span>{{ section.settings.payment_text }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "max_blocks": 3,
  "settings": [
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Texte de marque",
      "default": "Bien-être corps, esprit & maison. Sélection éthique expédiée depuis l'Europe."
    },
    {
      "type": "text",
      "id": "brand_note",
      "label": "Note (zones de livraison)",
      "default": "Livraison France · Belgique · Luxembourg"
    },
    {
      "type": "text",
      "id": "payment_text",
      "label": "Texte paiement",
      "default": "Paiement sécurisé · Bancontact · Carte · PayPal"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Colonne de menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Boutique" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pied de page",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Boutique", "menu": "main-menu" } },
        { "type": "menu", "settings": { "heading": "Aide", "menu": "footer" } },
        { "type": "menu", "settings": { "heading": "Informations", "menu": "footer" } }
      ]
    }
  ]
}
{% endschema %}
