<div class="udz-cart">
  <h1>Votre panier</h1>
  {%- if cart.item_count == 0 -%}
    <p style="color:var(--muted)">Votre panier est vide.</p>
    <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}" style="margin-top:16px">Découvrir la boutique</a>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post">
      {%- for item in cart.items -%}
        <div class="udz-cartline">
          {%- if item.image -%}<img src="{{ item.image | image_url: width: 180 }}" alt="{{ item.title | escape }}">{%- endif -%}
          <div style="flex:1">
            <a href="{{ item.url }}" style="font-weight:600;color:var(--text)">{{ item.product.title }}</a>
            {%- unless item.variant.title contains 'Default' -%}<div style="font-size:13px;color:var(--muted)">{{ item.variant.title }}</div>{%- endunless -%}
            <div style="font-size:13px;color:var(--muted)">{{ item.final_price | money }}</div>
          </div>
          <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:60px;padding:8px;border-radius:8px;border:1px solid var(--sand)">
          <strong>{{ item.final_line_price | money }}</strong>
        </div>
      {%- endfor -%}
      <div class="udz-cart__foot">
        <div class="udz-cart__box">
          <div style="display:flex;justify-content:space-between;margin-bottom:14px"><span>Sous-total</span><strong>{{ cart.total_price | money }}</strong></div>
          <button type="submit" name="update" class="btn btn--ghost btn--block" style="margin-bottom:8px">Mettre à jour</button>
          <button type="submit" name="checkout" class="btn btn--primary btn--block">Commander</button>
        </div>
      </div>
    </form>
  {%- endif -%}
</div>
{% schema %}
{ "name": "Panier", "settings": [] }
{% endschema %}
