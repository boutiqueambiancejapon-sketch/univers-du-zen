<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ shop.url }}" },
    { "@type": "ListItem", "position": 2, "name": "Boutique", "item": "{{ shop.url }}{{ routes.all_products_collection_url }}" },
    { "@type": "ListItem", "position": 3, "name": {{ collection.title | json }}, "item": "{{ shop.url }}{{ collection.url }}" }
  ]
}
</script>

<section class="page-width">
  <div class="collection-banner">
    <nav class="breadcrumb" aria-label="Fil d'Ariane">
      <a href="{{ routes.root_url }}">Accueil</a>
      <span aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}">Boutique</a>
      <span aria-hidden="true">/</span>
      <span>{{ collection.title }}</span>
    </nav>
    <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="collection-banner__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection-banner__desc rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  {%- paginate collection.products by section.settings.products_per_page -%}

    <div class="collection-toolbar">
      <span class="collection-toolbar__count">
        {{ 'collections.general.products_count' | t: count: collection.products_count }}
      </span>

      <form method="get" action="{{ collection.url }}">
        <label class="visually-hidden" for="sort-by">{{ 'collections.general.sort_by' | t }}</label>
        <select id="sort-by" name="sort_by" onchange="this.form.submit()">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="collection-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="collection-empty">{{ 'collections.general.no_products' | t }}</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}">‹ {{ 'general.pagination.previous' | t }}</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="is-current">{{ part.title }}</span>
          {%- else -%}
            <span>{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }} ›</a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{%- comment -%} Bloc éditorial SEO : description longue + FAQ (metafields custom.long_description / custom.faq) {%- endcomment -%}
{%- assign long_desc = collection.metafields.custom.long_description.value -%}
{%- assign faq = collection.metafields.custom.faq.value -%}

{%- if long_desc != blank or faq.size > 0 -%}
  <div class="seo-block">
    <div class="seo-block__inner">
      {%- if long_desc != blank -%}
        <div class="seo-block__text">
          {%- assign paras = long_desc | newline_to_br | split: '<br />' -%}
          {%- for para in paras -%}
            {%- assign trimmed = para | strip -%}
            {%- if trimmed == blank -%}{%- continue -%}{%- endif -%}
            {%- if trimmed contains '## ' and trimmed.size < 120 -%}
              <h2>{{ trimmed | remove_first: '## ' }}</h2>
            {%- else -%}
              <p>{{ trimmed }}</p>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if faq.size > 0 -%}
        <div class="seo-block__faq">
          <h2>Questions fréquentes</h2>
          {%- for item in faq -%}
            <details class="faq-item">
              <summary><h3>{{ item.question }}</h3><span aria-hidden="true">▾</span></summary>
              <div class="faq-item__answer">{{ item.answer }}</div>
            </details>
          {%- endfor -%}
        </div>

        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {%- for item in faq -%}
            {
              "@type": "Question",
              "name": {{ item.question | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | json }} }
            }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
        </script>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Page collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Boutique" },
    { "type": "range", "id": "products_per_page", "label": "Produits par page", "min": 8, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}
