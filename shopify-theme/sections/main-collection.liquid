<section class="page-width">
  <div class="collection-banner">
    <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="collection-banner__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection-banner__desc rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  {%- paginate collection.products by section.settings.products_per_page -%}

    <div class="collection-toolbar">
      <span class="collection-toolbar__count">
        {{ 'collections.general.products_count' | t: count: collection.products_count }}
      </span>

      <form method="get" action="{{ collection.url }}">
        <label class="visually-hidden" for="sort-by">{{ 'collections.general.sort_by' | t }}</label>
        <select id="sort-by" name="sort_by" onchange="this.form.submit()">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </form>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="collection-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="collection-empty">{{ 'collections.general.no_products' | t }}</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}">‹ {{ 'general.pagination.previous' | t }}</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="is-current">{{ part.title }}</span>
          {%- else -%}
            <span>{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }} ›</a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Page collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Boutique" },
    { "type": "range", "id": "products_per_page", "label": "Produits par page", "min": 8, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}
