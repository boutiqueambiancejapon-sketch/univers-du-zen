<section class="udz-sec">
  <div class="wrap">
    <div class="udz-sechead" data-reveal>
      <h2>{{ section.settings.heading }}</h2>
      <a class="udz-morelink" href="{{ routes.collections_url }}">Toutes les collections →</a>
    </div>
    <div class="udz-bento">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        <a href="{{ col.url | default: '#' }}" style="grid-column:{{ block.settings.grid_column }};grid-row:{{ block.settings.grid_row }}" {{ block.shopify_attributes }} data-reveal>
          {%- if block.settings.image -%}
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ col.title }}" loading="lazy">
          {%- elsif col.featured_image -%}
            <img src="{{ col.featured_image | image_url: width: 800 }}" alt="{{ col.title }}" loading="lazy">
          {%- endif -%}
          {%- if col.products_count > 0 -%}
            <span class="udz-bento__count">{{ col.products_count }} produits</span>
          {%- endif -%}
          <div class="udz-bento__cap">
            <span class="udz-bento__name">{{ block.settings.title | default: col.title }}</span>
            <span class="udz-bento__arrow">→</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Univers (bento)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Explorez nos univers" }
  ],
  "blocks": [
    { "type": "tile", "name": "Tuile collection", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "title", "label": "Titre affiché (option)" },
      { "type": "image_picker", "id": "image", "label": "Image (option)" },
      { "type": "text", "id": "grid_column", "label": "Colonne (ex: 1 / span 2)", "default": "auto" },
      { "type": "text", "id": "grid_row", "label": "Ligne (ex: 1 / span 2)", "default": "auto" }
    ]}
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Univers (bento)", "blocks": [
    { "type": "tile", "settings": { "grid_column": "1 / span 2", "grid_row": "1 / span 2" } },
    { "type": "tile", "settings": { "grid_column": "3", "grid_row": "1" } },
    { "type": "tile", "settings": { "grid_column": "4", "grid_row": "1" } },
    { "type": "tile", "settings": { "grid_column": "3 / span 2", "grid_row": "2" } },
    { "type": "tile", "settings": { "grid_column": "1", "grid_row": "3" } },
    { "type": "tile", "settings": { "grid_column": "2 / span 3", "grid_row": "3" } }
  ]}]
}
{% endschema %}
