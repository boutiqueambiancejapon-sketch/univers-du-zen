<div class="udz-plp__head">
  <div class="wrap"><h1>Toutes nos collections</h1><p>Explorez l'ensemble de nos univers bien-être.</p></div>
</div>
<section class="udz-sec">
  <div class="wrap">
    <div class="udz-bento" style="grid-auto-rows:clamp(160px,16vw,210px)">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" style="grid-column:auto;grid-row:auto">
          {%- if collection.featured_image -%}<img src="{{ collection.featured_image | image_url: width: 700 }}" alt="{{ collection.title }}" loading="lazy">{%- endif -%}
          {%- if collection.products_count > 0 -%}<span class="udz-bento__count">{{ collection.products_count }} produits</span>{%- endif -%}
          <div class="udz-bento__cap"><span class="udz-bento__name">{{ collection.title }}</span><span class="udz-bento__arrow">→</span></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Liste des collections", "settings": [] }
{% endschema %}
