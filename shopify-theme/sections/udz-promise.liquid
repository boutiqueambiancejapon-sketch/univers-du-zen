<section class="udz-promise">
  <span class="udz-promise__blob udz-promise__blob--1"></span>
  <span class="udz-promise__blob udz-promise__blob--2"></span>
  <span class="udz-promise__smoke udz-promise__smoke--a"></span>
  <span class="udz-promise__smoke udz-promise__smoke--b"></span>
  <div class="udz-promise__grid">
    <div class="udz-promise__media">
      {%- if section.settings.image -%}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}">
      {%- endif -%}
    </div>
    <div data-reveal>
      <div class="eyebrow" style="color:#c8d1ba">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <div class="udz-stats">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            <div class="n">{%- if block.settings.count > 0 -%}<span data-count="{{ block.settings.count }}" data-suffix="{{ block.settings.suffix }}">{{ block.settings.count }}{{ block.settings.suffix }}</span>{%- else -%}{{ block.settings.number }}{%- endif -%}</div>
            <div class="l">{{ block.settings.label }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Notre promesse",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Notre promesse" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Des produits sincères, des matières honnêtes." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Chaque encens, chaque huile, chaque pierre est sélectionné auprès d'artisans qui travaillent la matière naturelle depuis des générations. Sans compromis, sans superflu." },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "blocks": [
    { "type": "stat", "name": "Statistique", "settings": [
      { "type": "number", "id": "count", "label": "Chiffre (animé)", "info": "Laisser vide pour un texte libre" },
      { "type": "text", "id": "suffix", "label": "Suffixe", "default": "%" },
      { "type": "text", "id": "number", "label": "Ou texte libre", "default": "100%" },
      { "type": "text", "id": "label", "label": "Légende", "default": "d'ingrédients d'origine naturelle" }
    ]}
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Notre promesse", "blocks": [
    { "type": "stat", "settings": { "count": 100, "suffix": "%", "label": "d'ingrédients d'origine naturelle" } },
    { "type": "stat", "settings": { "count": 48, "suffix": "h", "label": "livraison en France, Belgique & Luxembourg" } }
  ]}]
}
{% endschema %}
