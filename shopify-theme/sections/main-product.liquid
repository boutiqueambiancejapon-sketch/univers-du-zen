{%- assign current_v = product.selected_or_first_available_variant -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  {% if product.featured_image %}"image": [{% for image in product.images limit: 4 %}{{ image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],{% endif %}
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "sku": {{ current_v.sku | default: product.id | json }},
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": "{{ current_v.price | divided_by: 100.0 }}",
    "availability": "{% if current_v.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "itemCondition": "https://schema.org/NewCondition"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ shop.url }}" },
    {%- if collection -%}
    { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": "{{ shop.url }}{{ collection.url }}" },
    {%- else -%}
    { "@type": "ListItem", "position": 2, "name": "Boutique", "item": "{{ shop.url }}{{ routes.all_products_collection_url }}" },
    {%- endif -%}
    { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": "{{ shop.url }}{{ product.url }}" }
  ]
}
</script>

<section class="product-page page-width">
  <nav class="breadcrumb breadcrumb--product" aria-label="Fil d'Ariane">
    <a href="{{ routes.root_url }}">Accueil</a>
    <span aria-hidden="true">/</span>
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a>
    {%- else -%}
      <a href="{{ routes.all_products_collection_url }}">Boutique</a>
    {%- endif -%}
    <span aria-hidden="true">/</span>
    <span>{{ product.title }}</span>
  </nav>

  <div class="product-page__grid" data-product-form>

    {%- comment -%} Galerie {%- endcomment -%}
    <div data-gallery>
      <div class="product-gallery__main">
        {%- if product.featured_image != blank -%}
          <img src="{{ product.featured_image | image_url: width: 1200 }}"
               alt="{{ product.featured_image.alt | default: product.title | escape }}"
               data-main-image width="1200" height="1200">
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="product-gallery__thumbs">
          {%- for image in product.images -%}
            <button type="button"
              class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
              data-thumb data-src="{{ image | image_url: width: 1200 }}"
              aria-label="Image {{ forloop.index }}">
              <img src="{{ image | image_url: width: 200 }}" alt="" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Infos {%- endcomment -%}
    <div>
      {%- if product.type != blank -%}
        <p class="product-info__vendor">{{ product.type }}</p>
      {%- endif -%}

      <h1 class="product-info__title">{{ product.title }}</h1>

      {%- liquid
        assign current = product.selected_or_first_available_variant
        assign on_sale = false
        if current.compare_at_price > current.price
          assign on_sale = true
        endif
      -%}

      <div class="product-info__prices">
        <span class="product-info__price" data-price>{{ current.price | money }}</span>
        <span class="product-info__compare" data-compare-price {% unless on_sale %}hidden{% endunless %}>
          {%- if on_sale %}{{ current.compare_at_price | money }}{% endif -%}
        </span>
        {%- if product.tags contains 'best-seller' or product.tags contains 'bestseller' -%}
          <span class="badge badge--bestseller">{{ 'products.product.best_seller' | t }}</span>
        {%- endif -%}
      </div>

      <p class="product-info__tax">{{ 'products.product.tax_included' | t }} {{ 'products.product.shipping_note' | t }}</p>

      {%- form 'product', product, data-ajax-cart: '' -%}
        {%- unless product.has_only_default_variant -%}
          <label class="product-form__label" for="variant-select-{{ section.id }}">
            {{ product.options.first }}
          </label>
          <select id="variant-select-{{ section.id }}" name="id" class="product-form__select" data-variant-select>
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}"
                {% if variant == current %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}>
                {{ variant.title }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}
              </option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <input type="hidden" name="id" value="{{ current.id }}">
        {%- endunless -%}

        <div class="product-form__row">
          <div class="quantity-input">
            <button type="button" data-qty-change="-1" aria-label="−">−</button>
            <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}">
            <button type="button" data-qty-change="1" aria-label="+">+</button>
          </div>

          <button type="submit" class="btn btn--primary product-form__submit"
            data-add-text="{{ 'products.product.add_to_cart' | t }}"
            data-soldout-text="{{ 'products.product.sold_out' | t }}"
            data-adding-text="{{ 'products.product.adding' | t }}"
            {% unless current.available %}disabled{% endunless %}>
            {%- if current.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </button>
        </div>
      {%- endform -%}

      <script type="application/json" data-variants-json>
        {{ product.variants | json }}
      </script>

      {%- if product.description != blank -%}
        <div class="product-info__desc rte">{{ product.description }}</div>
      {%- endif -%}

      <div class="product-info__trust">
        <div class="product-info__trust-item">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>
          {{ section.settings.trust1 }}
        </div>
        <div class="product-info__trust-item">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
          {{ section.settings.trust2 }}
        </div>
        <div class="product-info__trust-item">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
          {{ section.settings.trust3 }}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page produit",
  "settings": [
    { "type": "text", "id": "trust1", "label": "Confiance 1", "default": "Livraison offerte dès 59 €" },
    { "type": "text", "id": "trust2", "label": "Confiance 2", "default": "Retours 30 jours" },
    { "type": "text", "id": "trust3", "label": "Confiance 3", "default": "Paiement sécurisé" }
  ]
}
{% endschema %}
