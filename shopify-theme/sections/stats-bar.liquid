<section class="stats-bar">
  <div class="page-width stats-bar__grid">
    {%- for block in section.blocks -%}
      <div class="stats-bar__stat" {{ block.shopify_attributes }}>
        <p class="stats-bar__value">{{ block.settings.value }}<span>{{ block.settings.suffix }}</span></p>
        <p class="stats-bar__label">{{ block.settings.label }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Barre de chiffres",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "stat",
      "name": "Chiffre",
      "settings": [
        { "type": "text", "id": "value", "label": "Valeur", "default": "347" },
        { "type": "text", "id": "suffix", "label": "Suffixe", "default": "+" },
        { "type": "text", "id": "label", "label": "Libellé", "default": "clients satisfaits" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barre de chiffres",
      "blocks": [
        { "type": "stat", "settings": { "value": "347", "suffix": "+", "label": "clients satisfaits" } },
        { "type": "stat", "settings": { "value": "4,8", "suffix": "/5", "label": "note moyenne" } },
        { "type": "stat", "settings": { "value": "100%", "suffix": "", "label": "naturel & éthique" } },
        { "type": "stat", "settings": { "value": "48h", "suffix": "", "label": "délai d'expédition" } }
      ]
    }
  ]
}
{% endschema %}
